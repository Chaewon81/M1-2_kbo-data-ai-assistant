OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MOCK_MODE=false
AI_PROVIDER=openai
OPENROUTER_API_KEY=
# 검토 이력용 선택 설정. 과제 제출 기본은 AI_PROVIDER=openai.
OPENROUTER_MODEL=openrouter/free
GOOGLE_APPLICATION_CREDENTIALS=
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DATA_PATH=M1-1_summary/data/processed/game_results.csv
# 여러 시즌을 분리 보관하고 함께 조회할 때 사용 (세미콜론 구분, DATA_PATH보다 우선)
DATA_PATHS=data/games/game_results_2023.csv;data/games/game_results_2024.csv;data/games/game_results_2025.csv;data/games/game_results_2026.csv
PITCHER_DATA_PATH=data/raw/pitcher_stats.csv
PITCHER_DATA_PATHS=data/pitchers/pitcher_stats_2023.csv;data/pitchers/pitcher_stats_2024.csv;data/pitchers/pitcher_stats_2025.csv;data/pitchers/pitcher_stats_2026.csv
# true: Firestore 대신 로컬 CSV·메모리 사용. Firestore 운영 시 false.
LOCAL_CSV_MODE=false
# 제출/배포는 true. 연결 실패 시 메모리 fallback 금지.
REQUIRE_FIRESTORE=false
# 실제 AI 요청: 서버 프로세스 전체 1분당 최대 요청 수 (Mock 제외)
CHAT_REQUESTS_PER_MINUTE=10
# 제출용 스크립트는 기본 true, 개발 스크립트는 false. 배포 시 명시적으로 설정.
AUTO_SYNC_ENABLED=false
# Render 배포 시 production. 시연 접근 키는 24자 이상으로 별도 생성.
APP_ENV=development
DEMO_ACCESS_KEY=
